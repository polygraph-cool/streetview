{"meta":{"title":"Title TK","description":"Description tk."},"body":[{"type":"intro","value":{"panorama_id":"9HYyBlskAKG3JAOJZHIqPQ","default_coords":"6.18, -.002","slides":[{"text":"What if you could search every visible word on New York City’s streets?","coords":"6.18, -.002","zoom":"50"},{"text":"Business signs, bumper stickers, advertisements—anything with text.","coords":"5.475862056987275,-0.015414696963291428","zoom":"50"},{"text":"Non-english text could indicate a cultural enclave, like this one in Sunset Park, Brooklyn.","coords":"3.3797708616687814, 0.10035814216467642","zoom":"100"},{"text":"We could find the phrases that comprise NYC vernacular.","coords":"4.469831123118143,-0.2938386458797666","zoom":"100"}]}},{"type":"intro2","value":{"panorama_id":"eMzKVPg2Q3nEta17HKhKmA","default_coords":"2.351689120036009,-0.014143438070879366","slides":[{"text":"Including the ones that uniquely blanket NYC.","coords":"2.947042, -.054863","zoom":"50"},{"text":"If you know, you know.","coords":"3.9125264042641925,-0.1208975362061322","zoom":"100"}]}},{"type":"intro3","value":{"panorama_id":"v6S1mWkHRGBS5WYM1STa8w","default_coords":"1.131262343432244,-0.07185682804934501","slides":[{"text":"We can search NYC’s text landscape for anything.","coords":"2.0980631806940506,-0.13564177237473896","zoom":"100"}]}},{"type":"ignore","value":[]}]}